<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="EuphonicaOnboardingWindow" parent="AdwApplicationWindow">
    <property name="default-width">400</property>
    <property name="default-height">500</property>
    <property name="height-request">640</property>
    <property name="width-request">360</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 750</condition>
        <setter object="player_bar" property="layout">1</setter>
        <setter object="queue_view" property="pane-collapsed">true</setter>
      </object>
    </child>
    <property name="content">
      <object class="GtkBox" id="content">
        <property name="halign">fill</property>
        <property name="orientation">1</property>
        <child>
          <object class="AdwToastOverlay" id="toast_overlay">
            <child>
              <object class="AdwToolbarView">
                <property name="content">
                  <object class="AdwStatusPage">
                    <property name="title">Welcome to Euphonica</property>
                    <child>
                      <object class="GtkButton" id="finish_btn">
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                        <property name="label" translatable="true">Start using Euphonica</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
