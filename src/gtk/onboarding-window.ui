<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="EuphonicaOnboardingWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="true">Euphonica</property>
    <property name="default-width">400</property>
    <property name="default-height">640</property>
    <property name="height-request">640</property>
    <property name="width-request">360</property>

    <property name="content">
      <object class="GtkBox" id="content">
        <property name="halign">fill</property>
        <property name="orientation">1</property>
        <child>
          <object class="AdwToastOverlay" id="toast_overlay">
            <child>
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar"></object>
                </child>
                <property name="content">
                  <!-- Page 1 -->
                  <object class="GtkBox">
                    <style>
                      <class name="padding-12"/>
                    </style>
                    <property name="orientation">1</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="true">How is your library organised?</property>
                        <property name="wrap">true</property>
                        <property name="justify">center</property>
                        <style>
                          <class name="title-1"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkOverlay">
                        <property name="margin-top">12</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <property name="spacing">12</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                            <child>
                              <object class="GtkGrid">
                                <property name="column-homogeneous">true</property>
                                <property name="row-homogeneous">true</property>
                                <property name="column-spacing">12</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">release-folder-1-symbolic</property>
                                    <property name="pixel-size">125</property>
                                    <style>
                                      <class name="accent"/>
                                    </style>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">mixed-folder-1-symbolic</property>
                                    <property name="pixel-size">125</property>
                                    <style>
                                      <class name="accent"/>
                                    </style>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">release-folder-2-symbolic</property>
                                    <property name="pixel-size">125</property>
                                    <style>
                                      <class name="accent"/>
                                    </style>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">mixed-folder-2-symbolic</property>
                                    <property name="pixel-size">125</property>
                                    <style>
                                      <class name="accent"/>
                                    </style>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="homogeneous">true</property>
                                <property name="spacing">12</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="true">Each album/release has its own folder</property>
                                    <property name="wrap">true</property>
                                    <property name="justify">center</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                    <style>
                                      <class name="heading"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="true">Other/mixed</property>
                                    <property name="wrap">true</property>
                                    <property name="justify">center</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                    <style>
                                      <class name="heading"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="overlay">
                          <object class="GtkBox">
                            <property name="homogeneous">true</property>
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkToggleButton" id="release_folder_library_mode">
                                <property name="hexpand">true</property>
                                <accessibility>
                                  <property name="label" translatable="true">Each album/release has its own folder</property>
                                </accessibility>
                                <style>
                                  <class name="onboarding-option"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="mixed_library_mode">
                                <property name="group">release_folder_library_mode</property>
                                <property name="hexpand">true</property>
                                <accessibility>
                                  <property name="label" translatable="true">Other/mixed</property>
                                </accessibility>
                                <style>
                                  <class name="onboarding-option"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="overlay">
                          <object class="GtkSeparator">
                            <property name="orientation">1</property>
                            <property name="halign">center</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBox">
                        <property name="selection-mode">0</property>
                        <property name="margin-top">12</property>
                        <style>
                          <class name="boxed-list"/>
                        </style>
                        <child>
                          <object class="AdwExpanderRow">
                            <property name="title" translatable="true">Why does Euphonica need this?</property>
                            <property name="expanded">false</property>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="selectable">false</property>
                                <property name="activatable">false</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="true">PLACEHOLDER</property>
                                    <property name="wrap">true</property>
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="padding-12"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="finish_btn">
                        <property name="margin-top">12</property>
                        <property name="sensitive">false</property>
                        <property name="vexpand">true</property>
                        <property name="valign">end</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                        <property name="label" translatable="true">Start using Euphonica</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
