<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <requires lib="Adw" version="1.0" />
  <template class="EuphonicaOutputRow" parent="GtkWidget">
    <child>
      <object class="GtkListBox">
        <style>
          <class name="boxed-list"/>
        </style>
        <property name="selection-mode">none</property>
        <child>
          <object class="AdwExpanderRow" id="header">
            <property name="title" bind-source="name" bind-property="text" bind-flags="sync-create"/>
            <child type="prefix">
              <object class="GtkImage" id="icon">
                <property name="icon-name">soundcard-symbolic</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="name">
                <property name="title" translatable="true">Output name</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="enabled">
                <property name="title" translatable="true">Enable on startup</property>
                <property name="subtitle" translatable="true">If disabled, will be off on every startup. If enabled, will remember previous runtime state.</property>
              </object>
            </child>
            <child>
              <object class="GtkListBoxRow">
                <style>
                  <class name="padding-12"/>
                </style>
                <child>
                  <object class="GtkGrid">
                    <property name="row-spacing">6</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <style>
                          <class name="subtitle"/>
                        </style>
                        <property name="label" translatable="true">Output type</property>
                        <property name="hexpand">true</property>
                        <property name="halign">start</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <style>
                          <class name="subtitle"/>
                        </style>
                        <property name="label" translatable="true">Ordering</property>
                        <property name="halign">start</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="output_type">
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <style>
                          <class name="linked"/>
                        </style>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                        <child>
                          <object class="GtkButton" id="raise">
                            <property name="icon-name">up-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="lower">
                            <property name="icon-name">down-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkMenuButton" id="remove_confirm">
                            <style>
                              <class name="destructive-action"/>
                            </style>
                            <property name="icon-name">user-trash-symbolic</property>
                            <property name="popover">delete_popover</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkListBoxRow" id="force_format_area">
                <child>
                  <object class="GtkBox">
                    <property name="orientation">1</property>
                    <child>
                      <object class="AdwSwitchRow" id="force_format">
                        <property name="title" translatable="true">Force output format</property>
                        <property name="subtitle" translatable="true">Always open the device with this format, regardless of the input format.</property>
                      </object>
                    </child>
                    <child>
                      <object class="EuphonicaAudioFormatEntry" id="force_format_entry">
                        <property name="visible" bind-source="force_format" bind-property="active" bind-flags="sync-create"/>
                        <style>
                          <class name="padding-12"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="send_tags">
                <property name="title" translatable="true">Send tags</property>
                <property name="subtitle" translatable="true">Only useful for output plugins that can receive tags, e.g. HTTPD.</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="always_on">
                <property name="title" translatable="true">Keep device on</property>
                <property name="subtitle" translatable="true">Instead of closing the device at the end of playback, put it in “pause” mode. Only works with output plugins that suport “pause” mode, e.g. ALSA.</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="always_off">
                <property name="title" translatable="true">Non-playback</property>
                <property name="subtitle" translatable="true">Never play back through this device even if enabled. Useful for creating null devices for other software to react to.</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="mixer_type">
                <property name="title" translatable="true">Mixer type</property>
                <property name="subtitle" translatable="true">Software mixer is available for most plugins. ALSA, OSS and PulseAudio additionally expose a hardware mixer. Use the 'null' mixer to ignore volume control or 'none' to disable entirely.</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="replaygain_handler">
                <property name="title" translatable="true">ReplayGain handler</property>
                <property name="subtitle" translatable="true">Software ReplayGain is applied before mixing. Mixer-mode ReplayGain uses the above mixer itself.</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <object class="GtkPopover" id="delete_popover">
      <property name="has-arrow">true</property>
      <property name="name">delete_popover</property>
      <property name="child">
        <object class="GtkBox">
          <property name="orientation">1</property>
          <property name="spacing">6</property>
          <child>
            <object class="GtkLabel">
              <property name="label" translatable="true">Remove this output plugin? This cannot be undone.</property>
            </object>
          </child>
          <child>
            <object class="GtkButton" id="remove">
              <property name="label" translatable="true">Remove</property>
              <style>
                <class name="destructive-action"/>
              </style>
            </object>
          </child>
        </object>
      </property>
    </object>
  </template>
</interface>
