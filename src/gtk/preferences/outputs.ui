<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="EuphonicaAudioOutputs" parent="GtkBox">
    <property name="orientation">1</property>
    <child>
      <object class="AdwBanner" id="error_banner">
        <property name="visible" bind-source="EuphonicaAudioOutputs" bind-property="is-valid" bind-flags="sync-create|invert-boolean"/>
        <property name="title" translatable="true">Outputs must have unique names.</property>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="outputs_window">
        <property name="height-request">50</property>
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="propagate-natural-height">true</property>
        <property name="has-frame">false</property>
        <child>
          <object class="GtkListBox" id="listbox">
            <property name="selection-mode">none</property>
            <style>
              <class name="no-bg"/>
              <class name="padding-6"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
