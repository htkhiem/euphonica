<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<requires lib="gtk" version="4.0" />
	<requires lib="Adw" version="1.9" />
	<template class="EuphonicaSidebar" parent="GtkBox">
		<child>
			<object class="AdwSidebar" id="inner">
				<child>
					<object class="AdwSidebarSection">
						<child>
							<object class="AdwSidebarItem" id="recent_btn">
								<property name="title" translatable="true">Recent</property>
								<property name="icon-name">recent-symbolic</property>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="AdwSidebarSection">
						<property name="title" translatable="true">Library</property>
						<child>
							<object class="AdwSidebarItem" id="albums_btn">
								<property name="title" translatable="true">Albums</property>
								<property name="icon-name">library-music-symbolic</property>
							</object>
						</child>
						<child>
							<object class="AdwSidebarItem" id="artists_btn">
								<property name="title" translatable="true">Artists</property>
								<property name="icon-name">music-artist-symbolic</property>
							</object>
						</child>
						<child>
							<object class="AdwSidebarItem" id="folders_btn">
								<property name="title" translatable="true">Folders</property>
								<property name="icon-name">folder-symbolic</property>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="AdwSidebarSection" id="dyn_playlists_section">
						<property name="title" translatable="true">Dynamic Playlists</property>
						<property name="suffix">
							<object class="GtkButton" id="add_dyn_playlist_btn">
								<property name="icon-name">plus-symbolic</property>
								<style>
									<class name="flat"/>
								</style>
							</object>
						</property>
						<child>
							<object class="AdwSidebarItem" id="dyn_playlists_btn">
								<property name="title" translatable="true">All</property>
								<property name="icon-name">playlist-symbolic</property>
							</object>
						</child>
						<!-- Items for recent playlists are added programmatically -->
					</object>
				</child>
				<child>
					<object class="AdwSidebarSection" id="playlists_section">
						<property name="title" translatable="true">Saved Playlists</property>
						<child>
							<object class="AdwSidebarItem" id="playlists_btn">
								<property name="title" translatable="true">All</property>
								<property name="icon-name">playlist-symbolic</property>
							</object>
						</child>
						<!-- Items for recent playlists are added programmatically -->
					</object>
				</child>
				<child>
					<object class="AdwSidebarSection" id="queue_section">
						<child>
							<object class="AdwSidebarItem" id="queue_btn">
								<property name="title" translatable="true">Queue</property>
								<property name="icon-name">play-symbolic</property>
								<property name="suffix">
									<object class="GtkLabel" id="queue_len">
										<property name="label">0</property>
									</object>
								</property>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>
	</template>
</interface>
