<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="EuphonicaDiscographyAlbum" parent="GtkBox">
    <property name="orientation">1</property>
    <property name="spacing">6</property>
    <child>
      <object class="GtkButton" id="title_btn">
        <style>
          <class name="padding-0"/>
          <class name="flat"/>
        </style>
        <property name="halign">start</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel" id="title">
                <property name="halign">start</property>
                <property name="wrap">true</property>
                <property name="justify">left</property>
                <property name="label">Untitled Album</property>
                <style>
                  <class name="title-4"/>
                </style>
              </object>
            </child>
            <child>
              <!-- Should only display if navigable -->
              <object class="GtkImage" id="title_arrow">
                <style>
                  <class name="dimmed"/>
                </style>
                <property name="icon-name">info-outline-symbolic</property>
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkBox" id="inner">
        <property name="spacing">6</property>
        <child>
          <object class="GtkBox">
            <property name="halign">1</property>
            <property name="valign">1</property>
            <property name="overflow">hidden</property>
            <style>
              <class name="border-radius-6" />
            </style>
            <child>
              <object class="EuphonicaImageStack" id="cover">
                <property name="size">160</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkBox">
            <property name="orientation">1</property>
            <property name="spacing">6</property>
            <child>
              <object class="AdwWrapBox">
                <property name="child-spacing">6</property>
                <property name="line-spacing">6</property>
                <!-- Play, queue, add to playlist -->
                <child>
                  <object class="GtkButton" id="replace_queue">
                    <property name="tooltip-text" translatable="true">Replace the queue with the selected songs</property>
                    <style>
                      <class name="suggested-action"/>
                    </style>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">play-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="replace_queue_text">
                            <property name="label" translatable="true">Play all</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSplitButton" id="queue_split_button">
                    <property name="menu-model">queue_menu_model</property>
                    <child>
                      <object class="AdwButtonContent" id="queue_split_button_content">
                        <property name="icon-name">list-add-symbolic</property>
                        <property name="label" translatable="true">Queue all</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="EuphonicaAddToPlaylistButton" id="add_to_playlist"/>
                </child>

                <child>
                  <object class="GtkButton" id="sel_all">
                    <property name="icon-name">edit-select-all-symbolic</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="sel_none">
                    <property name="icon-name">edit-select-none-symbolic</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="collapse_content_btn">
                    <style>
                      <class name="flat"/>
                    </style>
                    <property name="icon-name">up-symbolic</property>
                    <property name="tooltip-text" translatable="true">Collapse album content</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkRevealer" id="content_revealer">
                <property name="transition-type">5</property>
                <property name="child">
                  <object class="EuphonicaContentStack" id="content_stack">
                    <property name="placeholder">
                      <object class="AdwStatusPage">
                        <property name="title" translatable="true">Empty Album</property>
                      </object>
                    </property>
                    <property name="content">
                      <object class="GtkListBox" id="content">
                        <property name="selection-mode">3</property>
                        <property name="activate-on-single-click">false</property>
                        <property name="show-separators">true</property>
                        <property name="valign">start</property>
                        <style>
                          <class name="no-bg"/>
                          <class name="frame"/>
                          <class name="border-radius-6"/>
                        </style>
                      </object>
                    </property>
                    <property name="width-request">240</property>
                    <property name="height-request">240</property>
                    <property name="margin-bottom">12</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <menu id="queue_menu_model">
      <item>
        <attribute name="label" translatable="true">Queue all next</attribute>
        <attribute name="action">discography-album.insert-queue</attribute>
      </item>
    </menu>
  </template>
</interface>

