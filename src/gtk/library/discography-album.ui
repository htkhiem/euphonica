<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="EuphonicaDiscographyAlbum" parent="GtkWidget">
    <child>
      <object class="AdwBreakpointBin">
        <child>
          <object class="AdwBreakpoint">
            <condition>max-width: 600px</condition>
            <setter object="inner" property="orientation">1</setter>
            <setter object="wiki_line" property="align">0.5</setter>
            <!-- Disable clamping in this layout -->
            <setter object="title_clamp" property="maximum-size">999</setter>            
            <setter object="title_clamp" property="tightening-threshold">999</setter>
          </object>
        </child>
        <property name="child">
          <object class="GtkBox" id="inner">
            <child>
              <object class="AdwClamp" id="title_clamp">
                <property name="maximum-size">350</property>
                <property name="tightening-threshold">240</property>  
                <child>
                  <!-- Cover & title -->
                  <object class="GtkBox"> 
                    <property name="orientation">1</property>
                    
                    <child>
                      <object class="GtkBox">
                        <property name="halign">3</property>
                        <property name="valign">3</property>
                        <property name="overflow">hidden</property>
                        <style>
                          <class name="border-radius-6" />
                        </style>
                        <child>
                          <object class="EuphonicaImageStack" id="cover">
                            <property name="size">290</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="title">
                        <property name="halign">start</property>
                        <property name="wrap">true</property>
                        <property name="justify">left</property>
                        <property name="label">Untitled Album</property>
                        <style>
                          <class name="title-1"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="orientation">1</property>
                <property name="spacing">6</property>
                <!-- Action row -->
                <child>
                  <object class="GtkBox">
                    <property name="spacing">6</property>
                    <!-- Play, queue, add to playlist -->
                    <child>
                      <object class="GtkButton" id="replace_queue">
                        <property name="tooltip-text" translatable="true">Replace the queue with this album</property>
                        <style>
                          <class name="suggested-action"/>
                        </style>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">Play</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">play-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="GtkButton" id="append_queue">
                        <property name="tooltip-text" translatable="true">Add this album's songs to the end of the queue</property>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">Queue</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">list-add-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="EuphonicaAddToPlaylistButton" id="add_to_playlist"/>
                    </child>
                  </object>
                </child>

                <!-- Content ListBox -->
                <child>
                  <object class="EuphonicaContentStack" id="content_stack">
                    <property name="placeholder">
                      <object class="AdwStatusPage">
                        <property name="title" translatable="true">Empty Album</property>
                      </object>
                    </property>
                    <property name="content">
                      <object class="GtkListBox" id="content">
                        <style>
                          <class name="boxed-list"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
