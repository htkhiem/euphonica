<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<template class="EuphonicaArtistCell" parent="GtkBox">
		<style>
			<class name="padding-18"/>
		</style>
		<property name="orientation">1</property>
		<property name="spacing">6</property>
		<child>
			<object class="GtkOverlay">
				<child>
					<object class="EuphonicaCoverFan" id="covers">
						<property name="width-request">140</property>
						<property name="height-request">140</property>
					</object>
				</child>
				<child type="overlay">
					<object class="AdwAvatar" id="avatar">
						<property name="halign">center</property>
						<property name="valign">end</property>
						<property name="show-initials">true</property>
						<property name="size">96</property>
					</object>
				</child>
			</object>
		</child>
		<child>
			<object class="GtkLabel" id="name">
				<property name="wrap">true</property>
				<property name="ellipsize">3</property>
				<property name="lines">2</property>
				<style>
					<class name="caption-heading"/>
				</style>
			</object>
		</child>
	</template>
</interface>
