<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="EuphonicaRecentView" parent="GtkWidget">
    <child>
      <object class="AdwBreakpointBin">
        <property name="width-request">240</property>
        <property name="height-request">240</property>
        <child>
          <object class="AdwBreakpoint">
            <condition>min-width: 900px</condition>
            <setter object="multi_layout_view" property="layout-name">wide</setter>
            <setter object="rediscover_multi_layout_view" property="layout-name">wide</setter>
          </object>
        </child>

        <property name="child">
          <object class="AdwToolbarView">
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <child type="top">
              <object class="AdwHeaderBar" id="header_bar">
                <property name="show-title">false</property>
                <child type="start">
                  <object class="GtkButton" id="show_sidebar">
                    <property name="icon-name">dock-left-symbolic</property>
                    <property name="tooltip-text" translatable="true">Show sidebar</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="AdwMultiLayoutView" id="multi_layout_view">
                <child type="greeting">
                  <object class="GtkBox">
                    <property name="orientation">1</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkLabel" id="greeting">
                        <!-- Good morning, good afternoon, good evening -->
                        <!-- Rare todo: customisable greetings? -->
                        <style>
                          <class name="title-1"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="AdwWrapBox">
                        <property name="child-spacing">6</property>
                        <property name="line-spacing">6</property>
                        <property name="justify">0</property>
                        <property name="align">0.5</property>
                        <child>
                          <object class="GtkButton" id="albums_badge">
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">1</property>
                                <!-- <property name="spacing">6</property> -->
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="accent"/>
                                    </style>
                                    <property name="label" translatable="true">Albums</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="albums_count">
                                    <style>
                                      <class name="title-1"/>
                                      <class name="numeric"/>
                                    </style>
                                    <property name="valign">end</property>
                                    <property name="label">-</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkButton" id="artists_badge">
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">1</property>
                                <!-- <property name="spacing">6</property> -->
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="accent"/>
                                    </style>
                                    <property name="label" translatable="true">Artists</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="artists_count">
                                    <style>
                                      <class name="title-1"/>
                                      <class name="numeric"/>
                                    </style>
                                    <property name="valign">end</property>
                                    <property name="label">-</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkButton" id="songs_badge">
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">1</property>
                                <!-- <property name="spacing">6</property> -->
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="accent"/>
                                    </style>
                                    <property name="label" translatable="true">Songs</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="songs_count">
                                    <style>
                                      <class name="title-1"/>
                                      <class name="numeric"/>
                                    </style>
                                    <property name="valign">end</property>
                                    <property name="label">-</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <!-- might display later: elapsed playback time, total DB play time, last DB update timestamp -->

                      </object>
                    </child>
                  </object>
                </child>

                <!-- Rediscover section consists of album and artist subections.
                    In the narrow layout they're horizontally scrollable rows just like the old Recent View Album and Artist sections.
                    Starting from the medium layout they're expanded to reflowing grids.
                    On the wider layout they're two grids arranged side by side.
                     -->
                <child type="rediscover">
                  <object class="GtkBox">
                    <property name="orientation">1</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkCenterBox">
                        <!-- Align start of text with visible content since most content rows/cells have a 6px padding already -->
                        <property name="margin-start">6</property>
                        <property name="margin-end">6</property>
                        <property name="start-widget">
                          <object class="GtkLabel">
                            <style>
                              <class name="title-2"/>
                            </style>
                            <property name="label" translatable="true">Rediscover</property>
                          </object>
                        </property>
                        <property name="end-widget">
                          <object class="GtkButton" id="refresh_rediscover">
                            <style>
                              <class name="flat"/>
                            </style>
                            <property name="icon-name">arrow-clockwise-symbolic</property>
                            <property name="tooltip-text" translatable="true">Refresh recommendations</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="EuphonicaContentStack" id="rediscover_content_stack">
                        <property name="placeholder">
                          <object class="AdwStatusPage">
                            <property name="title" translatable="true">Rediscover is Empty</property>
                            <property name="description" translatable="true">Grow your playback history for a few months first.</property>
                            <property name="icon-name">recent-symbolic</property>
                          </object>
                        </property>

                        <property name="content">
                          <object class="AdwMultiLayoutView" id="rediscover_multi_layout_view">
                            <child type="rediscover-albums">
                              <object class="GtkGridView" id="rediscover_albums">
                                <property name="single-click-activate">true</property>
                                <style>
                                  <class name="no-bg"/>
                                </style>
                              </object>
                            </child>

                            <child type="rediscover-artists">
                              <object class="GtkGridView" id="rediscover_artists">
                                <property name="single-click-activate">true</property>
                                <style>
                                  <class name="no-bg"/>
                                </style>
                              </object>
                            </child>

                            <child>
                              <object class="AdwLayout">
                                <!-- Default layout put first -->
                                <property name="name">medium</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">1</property>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="AdwLayoutSlot">
                                        <property name="id">rediscover-albums</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwLayoutSlot">
                                        <property name="id">rediscover-artists</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="AdwLayout">
                                <property name="name">wide</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="AdwLayoutSlot">
                                        <property name="id">rediscover-albums</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwLayoutSlot">
                                        <property name="id">rediscover-artists</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <!-- <child>
                              <object class="AdwLayout">
                                <property name="name">narrow</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">1</property>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="EuphonicaFadingScrolledWindow">
                                        <property name="vertical">false</property>
                                        <property name="vexpand">true</property>
                                        <property name="hexpand">true</property>
                                        <property name="inner">
                                          <object class="GtkScrolledWindow">
                                            <property name="hscrollbar-policy">automatic</property>
                                            <property name="vscrollbar-policy">never</property>
                                            <property name="propagate-natural-width">true</property>
                                            <property name="has-frame">false</property>
                                            <property name="hexpand">true</property>
                                            <child>
                                              <object class="AdwLayoutSlot">
                                                <property name="id">rediscover-albums</property>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </child>

                                    <child>
                                      <object class="EuphonicaFadingScrolledWindow">
                                        <property name="vertical">false</property>
                                        <property name="vexpand">true</property>
                                        <property name="hexpand">true</property>
                                        <property name="inner">
                                          <object class="GtkScrolledWindow">
                                            <property name="hscrollbar-policy">automatic</property>
                                            <property name="vscrollbar-policy">never</property>
                                            <property name="propagate-natural-width">true</property>
                                            <property name="has-frame">false</property>
                                            <property name="hexpand">true</property>
                                            <child>
                                              <object class="AdwLayoutSlot">
                                                <property name="id">rediscover-artists</property>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child> -->
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>

                <child type="recent">
                  <object class="GtkBox">
                    <property name="width-request">240</property>
                    <property name="orientation">1</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkCenterBox">
                        <!-- Align start of text with visible content since most content rows/cells have a 6px padding already -->
                        <property name="margin-start">6</property>
                        <property name="margin-end">6</property>
                        <property name="start-widget">
                          <object class="GtkBox">
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <style>
                                  <class name="title-2"/>
                                </style>
                                <property name="label" translatable="true">Recent</property>
                              </object>
                            </child>

                            <child>
                              <object class="AdwInlineViewSwitcher" id="recent_subview">
                                <property name="display-mode">1</property>
                                <property name="stack">recent_subview_stack</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="end-widget">
                          <object class="GtkButton" id="clear_history">
                            <style>
                              <class name="destructive-action"/>
                            </style>
                            <property name="icon-name">user-trash-symbolic</property>
                            <property name="tooltip-text" translatable="true">Clear history</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="EuphonicaContentStack" id="recent_content_stack">
                        <property name="hexpand">true</property>
                        <property name="placeholder">
                          <object class="AdwStatusPage">
                            <property name="title" translatable="true">No Recent Songs</property>
                            <property name="description" translatable="true">Songs, albums and artists played while Euphonica is running will appear here.</property>
                            <property name="icon-name">recent-symbolic</property>
                          </object>
                        </property>
                        <property name="content">
                          <object class="AdwViewStack" id="recent_subview_stack">
                            <child>
                              <object class="AdwViewStackPage">
                                <property name="name">albums</property>
                                <property name="icon-name">library-music-symbolic</property>
                                <property name="title">Recent Albums</property>
                                <property name="child">
                                  <object class="GtkGridView" id="recent_albums">
                                    <property name="single-click-activate">true</property>
                                    <style>
                                      <class name="no-bg"/>
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </child>

                            <child>
                              <object class="AdwViewStackPage">
                                <property name="name">artists</property>
                                <property name="icon-name">music-artist-symbolic</property>
                                <property name="title">Recent Artists</property>
                                <property name="child">
                                  <object class="GtkGridView" id="recent_artists">
                                    <property name="single-click-activate">true</property>
                                    <style>
                                      <class name="no-bg"/>
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </child>

                            <child>
                              <object class="AdwViewStackPage">
                                <property name="name">songs</property>
                                <property name="icon-name">music-note-single-symbolic</property>
                                <property name="title">Recent Songs</property>
                                <property name="child">
                                  <object class="GtkListBox" id="recent_songs">
                                    <property name="activate-on-single-click">false</property>
                                    <style>
                                      <class name="song-list"/>
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>

                </child>

                <child>
                  <object class="AdwLayout">
                    <property name="name">medium</property>
                    <!-- Medium layout: Vertical scroll, but sections are now more "expanded" -->
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">true</property>
                        <property name="hexpand">true</property>
                        <property name="propagate-natural-height">true</property>
                        <child>
                          <object class="GtkBox">
                            <property name="vexpand">true</property>
                            <property name="hexpand">true</property>
                            <property name="spacing">12</property>
                            <property name="orientation">1</property>

                            <child>
                              <object class="AdwLayoutSlot">
                                <property name="margin-start">6</property>
                                <property name="margin-end">6</property>
                                <property name="id">greeting</property>
                              </object>
                            </child>

                            <child>
                              <object class="GtkSeparator"/>
                            </child>

                            <!-- For now there's only Rediscover -->
                            <child>
                              <object class="AdwLayoutSlot">
                                <property name="margin-start">6</property>
                                <property name="margin-end">6</property>
                                <property name="id">rediscover</property>
                              </object>
                            </child>

                            <child>
                              <object class="GtkSeparator"/>
                            </child>

                            <child>
                              <object class="AdwLayoutSlot">
                                <property name="margin-start">6</property>
                                <property name="margin-end">6</property>
                                <property name="id">recent</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwLayout">
                    <property name="name">wide</property>
                    <!-- Wide layout: Revisit (and other recommender-based sections) to the left, stacked vertically
                        & in their full sizes; recent section to the right running the whole height, taking up at most 600px. -->
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">true</property>
                        <property name="hexpand">true</property>
                        <property name="propagate-natural-height">true</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <property name="spacing">12</property>
                            <child>
                              <object class="AdwLayoutSlot">
                                <property name="id">greeting</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkPaned">
                                <property name="shrink-start-child">false</property>
                                <property name="shrink-end-child">false</property>
                                <property name="start-child">
                                  <!-- Left: Recommenders -->
                                  <object class="GtkBox">
                                    <property name="orientation">1</property>
                                    <property name="hexpand">1</property>
                                    <property name="spacing">12</property>

                                    <!-- For now there's only Rediscover -->
                                    <child>
                                      <object class="AdwLayoutSlot">
                                        <property name="id">rediscover</property>
                                        <style>
                                          <class name="padding-12"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                                <property name="end-child">
                                  <!-- Right: Recent section -->
                                  <object class="AdwLayoutSlot">
                                    <property name="hexpand">true</property>
                                    <property name="id">recent</property>
                                    <style>
                                      <class name="padding-12"/>
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Narrow layout: for some reason horizontal scrolling doesn't work -->
                <!--
                <child>
                  <object class="AdwLayout">
                    <property name="name">narrow</property>

                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">true</property>
                        <property name="hexpand">true</property>
                        <property name="propagate-natural-height">true</property>
                        <child>
                          <object class="GtkBox">
                            <property name="vexpand">true</property>
                            <property name="hexpand">true</property>
                            <property name="spacing">12</property>
                            <property name="orientation">1</property>

                            <child>
                              <object class="AdwLayoutSlot">
                                <property name="id">greeting</property>
                              </object>
                            </child>

                            <child>
                              <object class="AdwLayoutSlot">
                                <property name="id">rediscover</property>
                              </object>
                            </child>

                            <child>
                              <object class="AdwLayoutSlot">
                                <property name="id">recent</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                -->

              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
