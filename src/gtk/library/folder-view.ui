<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="EuphonicaFolderView" parent="GtkWidget">
    <child>
      <object class="AdwToolbarView" id="top_view">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <!-- Shamelessly copying Nautilus' design -->
              <object class="GtkStack" id="path_stack">
                <property name="transition-type">1</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">buttons</property>
                    <property name="child">
                      <object class="GtkBox">
                        <style>
                          <class name="linked"/>
                        </style>

                        <child>
                          <object class="EuphonicaFadingScrolledWindow">
                            <style>
                              <class name="toolbar"/>
                              <class name="path-bar"/>
                              <class name="padding-3"/>
                            </style>
                            <property name="vertical">false</property>
                            <property name="vexpand">true</property>
                            <property name="hexpand">true</property>
                            <property name="inner">
                              <object class="GtkScrolledWindow" id="path_buttons_scroller">
                                <property name="hscrollbar-policy">external</property>
                                <property name="vscrollbar-policy">never</property>
                                <property name="propagate-natural-width">true</property>
                                <property name="has-frame">false</property>
                                <property name="hexpand">true</property>
                                <child>
                                  <object class="GtkBox" id="path_buttons">
                                    <child>
                                      <object class="GtkButton" id="home_btn">
                                        <child>
                                          <object class="AdwButtonContent">
                                            <property name="icon-name">go-home-symbolic</property>
                                            <property name="label" translatable="true">Library Root</property>
                                          </object>
                                        </child>
                                        <property name="tooltip-text" translatable="true">Go back to library root</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="enter_path">
                            <style>
                              <class name="flat"/>
                            </style>
                            <property name="icon-name">text-insert-symbolic</property>
                            <property name="tooltip-text" translatable="true">Enter path</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">entry</property>
                    <property name="child">
                      <object class="GtkBox">
                        <style>
                          <class name="linked"/>
                        </style>
                        <child>
                          <object class="GtkEntry" id="path_entry">
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="enter_path_cancel">
                            <property name="icon-name">cross-small-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
            <child type="start">
              <object class="GtkButton" id="show_sidebar">
                <property name="icon-name">dock-left-symbolic</property>
                <property name="tooltip-text" translatable="true">Show sidebar</property>
                <property name="visible">false</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="back_btn">
                <property name="icon-name">go-previous-symbolic</property>
                <property name="tooltip-text" translatable="true">Back</property>
                <property name="sensitive">false</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="forward_btn">
                <property name="icon-name">go-next-symbolic</property>
                <property name="tooltip-text" translatable="true">Forward</property>
                <property name="sensitive">false</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="search_btn">
                <property name="icon-name">edit-find-symbolic</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="view_options_btn">
                <property name="menu-model">view_options_model</property>
                <property name="icon-name">view-sort-ascending-symbolic</property>
              </object>
            </child>
          </object>
        </child>
        <child type="top">
          <object class="GtkSearchBar" id="search_bar">
            <child>
              <object class="GtkSearchEntry" id="search_entry">
                <property name="search-delay">150</property>
                <property name="width-request">100</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="valign">start</property>
            <property name="hexpand">true</property>
            <property name="orientation">1</property>
            <child>
              <object class="EuphonicaContentStack" id="stack">
                <property name="placeholder">
                  <object class="AdwStatusPage">
                    <property name="title" translatable="true">Empty Folder</property>
                  </object>
                </property>
                <property name="content">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">automatic</property>
                    <property name="propagate-natural-height">true</property>
                    <property name="has-frame">false</property>
                    <property name="vexpand">true</property>
                    <property name="child">
                      <object class="GtkListView" id="list_view">
                        <property name="margin-start">6</property>
                        <property name="margin-end">6</property>
                        <property name="single-click-activate">false</property>
                        <style>
                          <class name="song-list"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <menu id="view_options_model">
      <section>
        <attribute name="label" translatable="yes">Sort By</attribute>
        <item>
          <attribute name="label" translatable="true">Name</attribute>
          <attribute name="action">folder-view.sort-by</attribute>
          <attribute name="target">6</attribute>          <!-- See sortby enum -->
        </item>
        <item>
          <attribute name="label" translatable="true">Last Modified</attribute>
          <attribute name="action">folder-view.sort-by</attribute>
          <attribute name="target">7</attribute>          <!-- See sortby enum -->
        </item>
      </section>
      <section>
        <attribute name="label" translatable="yes">Sort Direction</attribute>
        <item>
          <attribute name="label" translatable="true">Ascending</attribute>
          <attribute name="action">folder-view.sort-direction</attribute>
          <attribute name="target">1</attribute>          <!-- See sortdir enum -->
        </item>
        <item>
          <attribute name="label" translatable="true">Descending</attribute>
          <attribute name="action">folder-view.sort-direction</attribute>
          <attribute name="target">0</attribute>          <!-- See sortdir enum -->
        </item>
      </section>
    </menu>

    <object class="AdwAlertDialog" id="invalid_path_dialog">
      <property name="heading" translatable="yes">Path not found</property>
      <property name="body" translatable="yes">Please double-check your entered path.</property>
      <property name="default-response">ok</property>
      <responses>
        <response id="ok" translatable="yes">OK</response>
      </responses>
    </object>
  </template>
</interface>
