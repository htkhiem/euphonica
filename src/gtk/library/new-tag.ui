<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="EuphonicaNewTag" parent="GtkBox">
    <!-- The below assumes that a LibAdwaita button is 34px tall. -->
    <style>
      <class name="linked"/>
    </style>
    <child>
      <object class="GtkEntry" id="name">
        <property name="placeholder-text" translatable="true">new tag...</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="add_btn">
        <style>
          <class name="plain-tag"/>
          <class name="round"/>
        </style>
        <property name="icon-name">plus-symbolic</property>
        <property name="sensitive">false</property>
      </object>
    </child>
  </template>
</interface>
