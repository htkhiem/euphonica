<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="EuphonicaSongInfoDialog" parent="AdwDialog">
    <property name="title" translatable="true">Song Info</property>
    <property name="content-width">600</property>
    <property name="width-request">300</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="GtkScrolledWindow">
            <style>
              <class name="no-bg"/>
            </style>
            <property name="propagate-natural-height">true</property>
            <property name="hscrollbar-policy">never</property>
            <property name="hexpand">true</property>
            <child>
              <object class="AdwClamp">
                <property name="child">
                  <object class="GtkBox">
                    <style>
                      <class name="padding-12"/>
                    </style>
                    <property name="spacing">12</property>
                    <property name="orientation">1</property>

                    <child>
                      <object class="EuphonicaImageStack" id="cover">
                        <!-- Keep same size as thumbnail since we'll mostly reuse the SongRow's texture. -->
                        <property name="size">36</property>
                        <property name="halign">center</property>
                        <property name="visible">false</property>
                      </object>
                    </child>

                    <child>
                      <object class="EuphonicaMarquee" id="name">
                        <property name="speed">20</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="title-2" />
                        </style>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="true">File</property>
                        <child>
                          <object class="AdwActionRow" id="path">
                            <property name="title" translatable="true">URI within library</property>
                            <style>
                              <class name="property"/>
                            </style>
                            <child type="suffix">
                              <object class="GtkButton" id="copy_path">
                                <property name="icon-name">copy-symbolic</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="format">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">Audio format</property>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="duration">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">Duration</property>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="added">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">Added</property>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="last_modified">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">Last modified</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <!-- Populated dynamically by SongInfoDialog::from_mpd_song -->
                      <object class="AdwPreferencesGroup" id="metadata">
                        <property name="title" translatable="true">Metadata</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>

            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
