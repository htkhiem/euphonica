<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="EuphonicaSongInfoDialog" parent="AdwDialog">
    <property name="title" translatable="true">Song Info</property>
    <property name="width-request">300</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="GtkScrolledWindow">
            <property name="propagate-natural-height">true</property>
            <property name="hscrollbar-policy">never</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkBox">
                <property name="spacing">12</property>
                <property name="orientation">1</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>

                <child>
                  <object class="EuphonicaImageStack" id="cover">
                    <property name="size">96</property>
                    <property name="halign">center</property>
                  </object>
                </child>

                <child>
                  <object class="EuphonicaMarquee" id="name">
                    <property name="speed">20</property>
                    <style>
                      <class name="title-2" />
                    </style>
                  </object>
                </child>

                <child>
                  <object class="GtkListBox">
                    <style>
                      <class name="boxed-list"/>
                    </style>
                    <property name="selection-mode">0</property>
                    <property name="halign">center</property>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="true">File</property>
                        <child>
                          <object class="AdwActionRow" id="path">
                            <property name="title" translatable="true">URI within library</property>
                            <style>
                              <class name="property"/>
                            </style>
                            <child type="suffix">
                              <object class="GtkButton" id="copy_path">
                                <property name="icon-name">copy-symbolic</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="format">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">Audio format</property>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="added">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">Added</property>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="last_modified">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">Last modified</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="true">Metadata</property>

                        <child>
                          <object class="AdwActionRow" id="album">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">Album tags</property>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="artist">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">Artist tags</property>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="artistsort">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">ArtistSort tags</property>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="albumartist">
                            <style>
                              <class name="property"/>
                            </style>
                            <property name="title" translatable="true">AlbumArtist tags</property>
                          </object>
                        </child>

                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
